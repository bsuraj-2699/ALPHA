# Market data providers
# Upstox (Indian equities — quotes, OHLC, corporate actions, live WebSocket).
# Tokens are refreshed daily at 09:00 IST by the FastAPI startup hook.
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_initial_upstox_access_token_here
# One-time auth code from the Upstox login dialog (used only until the
# refresh-token grant takes over).
UPSTOX_AUTH_CODE=
UPSTOX_REFRESH_TOKEN=
UPSTOX_REDIRECT_URI=http://localhost:8000/callback

# Screener.in (Indian fundamentals). Optional — paste your logged-in
# session cookie to unlock premium tables; without it most public fields
# still parse.
SCREENER_SESSION_COOKIE=

# ===========================================================================
# LLM — single hosted provider, open-weight models (narration only; never
# changes a BUY/SELL/HOLD). Default: NVIDIA NIM (free tier, works from India).
# ===========================================================================
# LLM_API_BASE points at ANY OpenAI-compatible endpoint. Get a free key at
# https://build.nvidia.com. The same wiring works for Groq / OpenRouter / a
# local vLLM or Ollama /v1 — just change LLM_API_BASE + LLM_API_KEY + models.
#
# Leave LLM_API_KEY blank to run fully offline (templated prose, no API calls).
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_API_KEY=
# Primary model (handles every narration call):
LLM_MODEL=openai/gpt-oss-120b
# Fallback model — takes over automatically if the primary fails:
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# Per-call timeout (s) so a slow/hung model fails over fast instead of blocking:
LLM_TIMEOUT=120

# --- Guardrails & rate limiting for agent LLM usage ---
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_MAX_CONCURRENCY=2
LLM_MAX_PROMPT_CHARS=24000
LLM_MAX_OUTPUT_CHARS=4000

# --- LangSmith tracing (optional; blank key disables it) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=alpha-fin-agent
LANGSMITH_TRACING=true

# Infrastructure. QDRANT_URL now also powers the intraday RAG "market memory"
# (similar historical fingerprints inform confidence + explanation; it never
# overrides the deterministic signal). Unset it to disable the memory layer.
QDRANT_URL=http://localhost:6335
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://fin:fin@localhost:5432/fin
